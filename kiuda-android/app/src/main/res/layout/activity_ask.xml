<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/neo_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/neo_bg"
        app:titleTextColor="@color/neo_text_dark"
        app:title="묻다 · AI 진단"
        app:navigationIconTint="@color/neo_text_dark" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Camera preview in soft card -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@drawable/bg_neo_card"
                android:padding="4dp">

                <androidx.camera.view.PreviewView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#1A2E1A" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCapture"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="📷  사진 촬영"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/neo_green_primary" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="작물 잎을 화면 중앙에 맞춰 촬영하세요."
                android:textSize="13sp"
                android:textColor="@color/neo_muted" />

            <!-- 증상 선택 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="증상 선택"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/neo_text_dark" />

            <LinearLayout
                android:id="@+id/containerSymptoms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:padding="16dp"
                android:background="@drawable/bg_neo_card"
                android:minHeight="56dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiagnose"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="🔍  AI 진단 요청"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:backgroundTint="@color/neo_green_dark" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/neo_green_primary"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
