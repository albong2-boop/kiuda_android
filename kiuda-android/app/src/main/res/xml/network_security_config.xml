<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 개발용: cleartext(HTTP) 허용. 배포 시 HTTPS로 변경 후 제거 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
