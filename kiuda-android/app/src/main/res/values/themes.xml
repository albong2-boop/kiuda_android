<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kiuda" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/neo_green_primary</item>
        <item name="colorPrimaryVariant">@color/neo_green_dark</item>
        <item name="colorOnPrimary">@color/neo_white</item>
        <item name="colorSecondary">@color/neo_leaf</item>
        <item name="colorOnSecondary">@color/neo_white</item>
        <item name="colorSurface">@color/neo_bg</item>
        <item name="colorOnSurface">@color/neo_text</item>
        <item name="android:colorBackground">@color/neo_bg</item>
        <item name="android:statusBarColor">@color/neo_green_dark</item>
        <item name="android:navigationBarColor">@color/neo_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialButtonStyle">@style/Widget.Kiuda.Button</item>
    </style>

    <style name="Theme.Kiuda.NoActionBar" parent="Theme.Kiuda">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Widget.Kiuda.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/neo_green_primary</item>
        <item name="android:textColor">@color/neo_white</item>
    </style>

    <style name="Widget.Kiuda.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/neo_green_primary</item>
        <item name="android:textColor">@color/neo_green_dark</item>
    </style>
</resources>
