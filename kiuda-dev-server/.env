# ===== Gemini (온새미 AI) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_PREDICT_MODEL=gemini-3.5-flash-lite
GEMINI_CACHE_TTL_MS=600000

# ===== NCPMS Open API (매뉴얼 기준) =====
# https://ncpms.rda.go.kr 로그인 → Open API 신청 후 apiKey
NCPMS_API_KEY=
NCPMS_USE_LIVE=1
NCPMS_SERVICE_URL=http://ncpms.rda.go.kr/npmsAPI/service
NCPMS_SERVICE_CODE_SICK=SVC01
NCPMS_SERVICE_TYPE=AA001
# 예찰 전용 코드가 있으면 설정 (없으면 SVC01 작물 검색으로 주의보 구성)
NCPMS_SERVICE_CODE_ALERT=
NCPMS_ALERTS_URL=

PORT=8080
JWT_SECRET=kiuda-dev-secret-change-me